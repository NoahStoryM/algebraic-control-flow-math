(for/list : (Listof (Listof Integer)) ((p (in-amb (let ((a (amb 1 2 3)) (b (amb 1 2 3))) (unless (= (+ a b) 4) (amb-fail)) (list a b))))) p)
  ⇒ ((1 3) (2 2) (3 1))
(run* (x y) (appendo x y (quote (1 2 3))))
  ⇒ ((() (1 2 3)) ((1) (2 3)) ((1 2) (3)) ((1 2 3) ()))
(run 3 q (alwayso))
  ⇒ (_0 _0 _0)
(within-2s (λ () (run 1 q (conde ((nevero)) ((== q (quote here)))))))
  ⇒ 两秒内没有答案
(parameterize ((current-amb-merger amb-interleave)) (run 1 q (conde ((nevero)) ((== q (quote here))))))
  ⇒ (here)
(parameterize ((current-amb-merger amb-interleave)) (run 4 (x y z) (appendo x y z)))
  ⇒ ((() _0 _0) ((_0) _1 (_0 . _1)) ((_0 _1) _2 (_0 _1 . _2)) ((_0 _1 _2) _3 (_0 _1 _2 . _3)))
(within-2s (λ () (parameterize ((current-amb-merger amb-interleave)) (run 1 q (conde ((spino)) ((== q (quote here))))))))
  ⇒ 两秒内没有答案
(let*-values (((v1 next) (amb-generate* (λ () (count-from 0)))) ((v2 next) (next)) ((v3 next) (next))) (list v1 v2 v3))
  ⇒ ((0) 1 (1))
(let*-values (((v1 next) (amb-generate* (λ () (amb (quote a))))) ((v2 next) (next))) (list v1 v2))
  ⇒ ((a) #f)
(list (xs (conj2 three later)) (xs (conj2/local three later)))
  ⇒ ((3 1 2) (1 2 3))
