(run* (x y) (appendo x y (quote (1 2 3))))
  ⇒ ((() (1 2 3)) ((1) (2 3)) ((1 2) (3)) ((1 2 3) ()))
(procedure? s0)
  ⇒ #t
(and (pair? s1) (list (car s1) (procedure? (cdr s1))))
  ⇒ (() #t)
(run 3 q (alwayso))
  ⇒ (_0 _0 _0)
(run 4 (x y z) (appendo x y z))
  ⇒ ((() _0 _0) ((_0) _1 (_0 . _1)) ((_0 _1) _2 (_0 _1 . _2)) ((_0 _1 _2) _3 (_0 _1 _2 . _3)))
(run 1 q (conde ((nevero)) ((== q (quote here)))))
  ⇒ (here)
(within-2s (λ () (run 1 q (conde ((nevero)) ((nevero))))))
  ⇒ 两秒内没有答案
