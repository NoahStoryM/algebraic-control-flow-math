(walk x (list (cons y 5) (cons x y)))
  ⇒ 5
(unify (list x 2) (list 1 y) empty-s)
  ⇒ ((y . 2) (x . 1))
(unify (list x 2) (list 1 x) empty-s)
  ⇒ #f
(unify x (list x) empty-s)
  ⇒ #f
((== x 1) empty-s)
  ⇒ (((x . 1)))
((disj2 (== x 1) (== x 2)) empty-s)
  ⇒ (((x . 1)) ((x . 2)))
((conj2 (disj2 (== x 1) (== x 2)) (== y x)) empty-s)
  ⇒ (((y . 1) (x . 1)) ((y . 2) (x . 2)))
((conj2 (== x 1) (== x 2)) empty-s)
  ⇒ ()
(succeed empty-s)
  ⇒ (())
(fail empty-s)
  ⇒ ()
(run* z (appendo (quote (1 2)) (quote (3)) z))
  ⇒ ((1 2 3))
(run* (x y) (appendo x y (quote (1 2 3))))
  ⇒ ((() (1 2 3)) ((1) (2 3)) ((1 2) (3)) ((1 2 3) ()))
(run* (x y) (== x y))
  ⇒ ((_0 _0))
(run* (x y) (== x x))
  ⇒ ((_0 _1))
(split (quote (1 2 3)))
  ⇒ ((() (1 2 3)) ((1) (2 3)) ((1 2) (3)) ((1 2 3) ()))
(join (quote (1 2)) (quote (3)))
  ⇒ ((1 2 3))
(run* x (fresh (y) (P x y)))
  ⇒ (5 6)
(within-2s (λ () (run 3 q (alwayso))))
  ⇒ 两秒内没有答案
(within-2s (λ () (run 4 (x y z) (appendo x y z))))
  ⇒ 两秒内没有答案
