(walk x (list (cons y 5) (cons x y)))
  ⇒ 5
(unify (list x 2) (list 1 y) (quote ()))
  ⇒ ((y . 2) (x . 1))
(unify (list x 2) (list 1 x) (quote ()))
  ⇒ #f
((== x 1) (quote ()))
  ⇒ (((x . 1)))
((disj (== x 1) (== x 2)) (quote ()))
  ⇒ (((x . 1)) ((x . 2)))
((conj (disj (== x 1) (== x 2)) (== y x)) (quote ()))
  ⇒ (((y . 1) (x . 1)) ((y . 2) (x . 2)))
((conj (== x 1) (== x 2)) (quote ()))
  ⇒ ()
(run* (z) (appendo (quote (1 2)) (quote (3)) z))
  ⇒ (((1 2 3)))
(run* (x y) (appendo x y (quote (1 2 3))))
  ⇒ ((() (1 2 3)) ((1) (2 3)) ((1 2) (3)) ((1 2 3) ()))
(run* (x y) (== x y))
  ⇒ ((_.0 _.0))
(run* (x y) (== x x))
  ⇒ ((_.0 _.1))
(run* (x y) (== x (list y 1 y)))
  ⇒ (((_.0 1 _.0) _.0))
((conj) (quote ()))
  ⇒ (())
((disj) (quote ()))
  ⇒ ()
(run* (x) (fresh (y) (P x y)))
  ⇒ ((5) (6))
(run* (q) (alwayso))
  ⇒ 两秒内没有答案
